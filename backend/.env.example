DATABASE_URL=sqlite+aiosqlite:///./pikpak_hub.db
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change-me
PIKPAK_PROXY=
PIKPAK_CAPTCHA_TOKEN=
# android（默认 App 凭证）| web（需 PIKPAK_CLIENT_ID=YUMx5nI8ZU8Ap8pm）
PIKPAK_CAPTCHA_SIGN_PROFILE=android
# 可选：固定用于预检查/生成 token 的 device_id（16-64 位，字母数字_-）
PIKPAK_FIXED_DEVICE_ID=
RUN_WORKER_INLINE=true
AUTO_CREATE_TABLES=true
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ORIGIN_REGEX=^https?://(localhost|127[.]0[.]0[.]1)(:[0-9]+)?$
# 管理运行日志：库内保留最近 N 天（默认 7）；更早记录会被定时任务删除。0=仅内存不写库。PostgreSQL 落库需 psycopg（requirements 已含）
ADMIN_LOG_RETENTION_DAYS=7
# 磁力/种子结果为文件夹时：只把不小于该字节数的文件作为取回候选（默认 100MB）；0=不展开文件夹（仍用任务 file_id 取链）
DOWNLOAD_FOLDER_MIN_SIZE_BYTES=104857600
DOWNLOAD_FOLDER_MAX_LINK_FILES=12
